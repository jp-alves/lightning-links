{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "1.4.2",
  "description": "__MSG_appDesc__",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.gstatic.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "offline_enabled": true
}
